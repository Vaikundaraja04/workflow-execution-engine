MONGODB_URI=mongodb://127.0.0.1:27017/workflow_engine?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
WORKER_CONCURRENCY=5
EXECUTION_ATTEMPTS=3
EXECUTION_BACKOFF_MS=1000
EXECUTION_TIMEOUT_MS=30000
# Comma-separated browser allow-list. Empty = no cross-origin browser calls.
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_LOGIN_LIMIT=
AUTH_REFRESH_LIMIT=
WORKER_INSTANCES=1
OBSERVABILITY_RETENTION_DAYS=7
METRICS_RECORD_INTERVAL_MS=60000
READINESS_SCAN_INTERVAL_MS=
READINESS_DROP_THRESHOLD=5
QUEUE_DEPTH_ALERT_THRESHOLD=100
WORKER_HEARTBEAT_ALERT_MS=60000
AI_COST_SPIKE_USD=10

# --- Integrations (optional; only needed for the corresponding features) ---
# Webhook payload signing. Unset falls back to a built-in key and raises a HIGH security-audit finding.
WEBHOOK_SECRET_KEY=
# Billing provider selection: mock | stripe | razorpay. NOTE: setting provider keys alone does NOT
# select the provider - this variable does (default mock).
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=
# Notifications: local (default) | sendgrid | ses | resend. Non-local providers fail fast with
# UNSUPPORTED_PROVIDER_OPERATION until configured.
NOTIFICATION_PROVIDER=
# Comma-separated email allow-list for platform-admin consoles (saas, sales, growth, partners, support).
PLATFORM_ADMIN_EMAILS=

# --- SaaS / growth tuning (optional; code defaults apply when unset) ---
SAAS_TRIAL_DAYS=
DEMO_TTL_HOURS=
DEMO_RESET_INTERVAL_MS=
SUBSCRIPTION_GRACE_DAYS=
SUBSCRIPTION_SWEEP_INTERVAL_MS=
APP_BASE_URL=

# --- Platform / multi-region (optional) ---
REGION=
DEPLOYMENT_MODE=
REDIS_CLUSTER_ENABLED=
REDIS_CLUSTER_NODES=

# --- Secrets with development-only fallbacks (MUST be set explicitly in production) ---
AUDIT_HMAC_SECRET=
IDP_SECRET_KEY=
JWT_SECRET=
